rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation Blueprints
    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'currency', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'currency', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 150
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.currency is string && data.currency in ['THB', 'USD', 'EUR', 'JPY']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'type', 'amount', 'category', 'title', 'date', 'monthKey', 'paymentMethod', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'type', 'amount', 'category', 'title', 'note', 'date', 'monthKey', 'paymentMethod', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == request.auth.uid && isValidId(data.userId)
        && data.type is string && data.type in ['income', 'expense']
        && data.amount is number && data.amount > 0 && data.amount <= 1000000000
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 50
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && (!('note' in data) || (data.note is string && data.note.size() <= 300))
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.paymentMethod is string && data.paymentMethod.size() >= 1 && data.paymentMethod.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBudget(data) {
      return data.keys().hasAll(['userId', 'monthKey', 'limitAmount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'monthKey', 'limitAmount', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == request.auth.uid && isValidId(data.userId)
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.limitAmount is number && data.limitAmount >= 0 && data.limitAmount <= 1000000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Private User Profiles (PII isolated to owner only; no list allowed)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUser(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'currency', 'updatedAt']);
      allow delete: if isValidId(userId) && isVerifiedUser() && isOwner(userId);
    }

    // User Transactions
    match /transactions/{transactionId} {
      allow get: if isValidId(transactionId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(transactionId)
        && isVerifiedUser()
        && isValidTransaction(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(transactionId)
        && isVerifiedUser()
        && isValidTransaction(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['type', 'amount', 'category', 'title', 'note', 'date', 'monthKey', 'paymentMethod', 'updatedAt']);
      allow delete: if isValidId(transactionId) && isVerifiedUser() && existing().userId == request.auth.uid;
    }

    // Monthly Budgets
    match /budgets/{budgetId} {
      allow get: if isValidId(budgetId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(budgetId)
        && isVerifiedUser()
        && isValidBudget(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(budgetId)
        && isVerifiedUser()
        && isValidBudget(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().monthKey == existing().monthKey
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['limitAmount', 'updatedAt']);
      allow delete: if isValidId(budgetId) && isVerifiedUser() && existing().userId == request.auth.uid;
    }
  }
}
